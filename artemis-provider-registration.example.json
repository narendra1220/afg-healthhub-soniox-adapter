{
  "displayName": "Soniox adapter",
  "serviceType": "custom:soniox-adapter",
  "apiKey": "<ADAPTER_AUTH_TOKEN>",
  "isDefault": false,
  "config": {
    "useForStt": true,
    "useForTts": true,
    "sttEndpoint": "wss://<PUBLIC_ADAPTER_HOST>/stt",
    "sttLanguages": [{ "code": "en" }],
    "ttsStreamingEndpoint": "wss://<PUBLIC_ADAPTER_HOST>/tts",
    "ttsLanguages": [{ "code": "en", "voices": [{ "value": "Adrian" }] }],
    "voiceId": "Adrian",
    "defaultLanguage": "en"
  }
}
