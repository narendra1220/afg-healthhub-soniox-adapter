ADAPTER_AUTH_TOKEN=replace-with-a-random-wrapper-token
SONIOX_API_KEY=inject-from-your-secret-manager
SONIOX_STT_AUTO_FINALIZE_SILENCE_MS=750
SONIOX_STT_SILENCE_RMS_THRESHOLD=200
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8080
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_STT_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_TTS_MODEL=tts-rt-v2
SONIOX_TTS_VOICE=Adrian
SONIOX_TTS_WS_URL=wss://tts-rt.soniox.com/tts-websocket
ADAPTER_LOG_TRANSCRIPTS=false
